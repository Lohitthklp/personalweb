{
    "name": "personalweb",
    "version": "1.0.0",
    "description": "Personal portfolio website",
    "packageManager": "pnpm@9.15.9",
    "scripts": {
        "dev": "serve .",
        "start": "serve .",
        "lint": "npm run lint:js && npm run lint:html && npm run lint:css && npm run lint:syntax",
        "lint:js": "eslint .",
        "lint:html": "html-validate index.html",
        "lint:css": "stylelint styles.css",
        "lint:syntax": "node --check script.js && node --check api/medium.js",
        "format:check": "prettier --check .",
        "validate": "npm run lint && npm run format:check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "html-validate": "^11.16.0",
        "prettier": "^3.9.9",
        "serve": "^14.2.4",
        "stylelint": "^17.15.0"
    }
}
